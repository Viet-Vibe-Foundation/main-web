generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EventCategory {
  id        String       @id @default(cuid())
  title     String
  bgColor   String
  isBold    Boolean      @default(false)
  isItalic  Boolean      @default(false)
  textColor String
  type      CategoryType
  post      Post[]       @relation("EventCategoryToPost")
  event     Event[]      @relation("EventToEventCategory")
}

model Event {
  id                 String          @id @default(cuid())
  keyName            String          @unique // keyName is made using title
  title              String          @unique
  description        String?
  location           String?
  days               String[]
  eventType          EventType

  startTime          String?
  endTime            String?
  startDate          DateTime?       @default(now())
  endDate            DateTime        @default(now())
  capacity           Int?

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  formLink           String?
  imgUrl             String?
  isPublished        Boolean         @default(false)
  stripePriceId      String?
  stripeProductId    String?
  subscribedPriceId  String?
  socialLinks        Json?
  subtitle           String?
  subImgUrls         Json?
  imgUrls            Json?
  seatingMap         Json?
  eventDiscounts     Json?
  eventCodeDiscounts Json?

  // Relations
  seriesId           String?
  sponsors           SponsorOnEvent[]
  series             EventSeries?    @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  schedules          EventSchedule[]
  tickets            EventTicket[]
  payments           Payment[]
  issuedTickets      IssuedTicket[]
  Review             Review[]
  form               EventForm[]
  jobs               Job[]
  shops              Shop[]
  categories         EventCategory[] @relation("EventToEventCategory")
  hosts              User[]          @relation("EventToUser")

  @@unique([title, eventType])
  @@index([id])
}

model EventSponsor {
  id          String             @id @default(cuid())
  name        String             @unique
  displayName Boolean            @default(false)
  imgUrl      String
  url         String?    
  description String?
  events      SponsorOnEvent[]
  isPartner   Boolean           @default(false)
}

model SponsorOnEvent {
  id        String       @id @default(cuid())
  eventId   String
  sponsorId String
  tier      SponsorTier  @default(Bronze)
  order     Int?         // Optional: for custom ordering within each tier
  createdAt DateTime     @default(now())
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsor   EventSponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@unique([eventId, sponsorId])
  @@index([eventId])
  @@index([sponsorId])
}

model EventSeries {
  id          String    @id @default(cuid())
  name        String    @unique
  keyName     String    @unique
  description String?
  eventType   EventType
  events      Event[]
}

model EventSchedule {
  id          String  @id @default(cuid())
  description String?
  startTime   String?
  endTime     String?
  position    Int
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventTicket {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  type      String
  imageUrl  String?    // Background for the ticket
  limit     Int?
  disabled  Boolean    @default(false)

  // Price and payment mode
  price     Decimal
  currency  String     @default("CAD")
  discountMemberPercent Int?
  payTotalNumber Int  @default(1) // this field represents the number of session this ticket has

  // Capacity just for this tier
  capacityPerTicket Int @default(1)

  // Time range
  validFrom   DateTime?
  validTo     DateTime?

  // Stripe catalog mapping
  stripeProductId String
  stripePriceId   String
  subscribedStripePriceId String?

  // Relation
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payments  Payment[]
  issuedTickets IssuedTicket[]
}

model EventForm {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())

  // Relation
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Data
  FormData Json
}

model User {
  id                   String        @id @default(cuid())
  name                 String?
  email                String        @unique
  eduEmail             String?
  age                  String?
  phone                String?
  address              String?
  password             String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  emailVerifiedDate    DateTime?
  eduEmailVerifiedDate DateTime?
  eduEmailExpiredDate  DateTime?
  image                String?
  role                 Role[]
  stripeSubscriptionId String?
  subscribeExpires     DateTime?
  subscribedAt         DateTime?
  phoneVerified        Boolean?      @default(false)
  accounts             Account[]
  applications         Application[]
  jobs                 Job[]
  payments             Payment[]     @relation("PaymentUser")
  monitoredPayments    Payment[]     @relation("PaymentMonitorUser")
  checkedInTickets     IssuedTicket[] @relation("TicketCheckedInBy")
  posts                Post[]
  likedPosts           PostLikes[]
  visitedPosts         PostVisits[]
  Review               Review[]
  Devices              UserDevice[]
  EventHost            Event[]       @relation("EventToUser")
  Shops                Shop[]
  receipts             Receipt[]
}

model UserDevice {
  id     String @id @default(cuid())
  userId String
  token  String @unique
  User   User   @relation(fields: [userId], references: [id])
}

model Post {
  id          String          @id @default(cuid())
  title       String          @unique
  content     String?
  summary     String?
  imgUrl      String?
  isPublished Boolean?        @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  postLikes   PostLikes[]
  postVisits  PostVisits[]
  categories  EventCategory[] @relation("EventCategoryToPost")

  @@unique([id, userId])
  @@index([id])
}

model Job {
  id           String        @id @default(cuid())
  title        String        @unique
  keyName      String        @unique
  description  String?
  jobType      JobType
  summary      String?
  startDate    DateTime?     @default(now())
  endDate      DateTime?     @default(now())
  location     String?
  isPublished  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String
  eventId      String?
  applications Application[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)


  @@unique([id, userId])
  @@index([id])
}

model Application {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  address         String
  city            String
  country         String
  postCode        String
  email           String
  phoneNumber     String
  resume          Bytes
  appliedAt       DateTime @default(now())
  jobId           String?
  userId          String
  positionToApply String?
  reasonToApply   String?
  job             Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  user            User     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([jobId, userId])
  @@index([id])
}

model Payment {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  type            PaymentType
  method          PaymentMethod @default(Stripe)
  expiresAt       DateTime?
  quantity        Int

  // Stripe 
  stripePaymentId String?

  // info
  pricePaid       Decimal
  refunded        Boolean     @default(false)
  totalRefundAmount Decimal?  
  seatNumber      String?
  note            String?
  
  // Guests information
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  otherGuests     Json?

  // Custom form responses
  formResponses   Json?       // Answers to EventForm questions
  
  // Discounts captured from CheckoutSessionData at payment creation time
  discountApplied Json?

  // Relations
  userId          String?
  monitorUserId   String?    
  eventId         String?
  eventTicketId   String?
  shopId          String?
  shopItemId      String?
  event           Event?       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user            User?        @relation("PaymentUser", fields: [userId], references: [id], onDelete: Restrict)
  monitorUser     User?        @relation("PaymentMonitorUser", fields: [monitorUserId], references: [id], onDelete: Restrict)
  eventTicket     EventTicket? @relation(fields: [eventTicketId], references: [id], onDelete: Restrict)
  shop            Shop?        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopItem        ShopItem?    @relation(fields: [shopItemId], references: [id], onDelete: Restrict)
  issuedTickets   IssuedTicket[]
}

/// One scannable ticket pass per purchased admission (quantity N => N rows).
model IssuedTicket {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Unguessable token encoded in the QR code
  qrToken         String    @unique
  seatLabel       String?
  checkedInAt     DateTime?
  checkedInById   String?

  paymentId       String
  eventId         String
  eventTicketId   String?

  payment         Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventTicket     EventTicket? @relation(fields: [eventTicketId], references: [id], onDelete: Restrict)
  checkedInBy     User?        @relation("TicketCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([paymentId])
  @@index([qrToken])
  @@index([checkedInAt])
}

model CheckoutSessionData {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Transaction status
  status          CheckoutSessionStatus @default(PENDING)
  
  // Representative guest (main contact)
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  
  // Seat and ticket data (for event)
  seatNumbers     Json?
  ticketMetadata  Json?
  // Shop item data  (for shopping)
  shopItemMetadata Json?               
  otherGuestsInfo Json?            // Other guests (array)
  
  // form responses
  formResponses   Json?            // Custom event registration form answers
  
  // Discount applied
  discountApplied Json?            // List of all applied discounts

  stripeSessionId String? @unique // Optional initially, set after session creation

  @@index([stripeSessionId]) // Fast lookup in webhook
  @@index([createdAt])       // For cleanup jobs (delete old records)
  @@index([status])          // For querying by status (cleanup, analytics)
} 

model PostLikes {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostVisits {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  pendingEduEmail String?
  token   String   @unique
  expires DateTime
  createdAt        DateTime      @default(now())

  @@unique([email, token])
}

model Review {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  userId    String
  eventId   String?
  rating    ReviewRating
  comment   String
  anonymous Boolean      @default(false)
  imageLink String?
  event     Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Shop {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  title       String
  description String?
  slug        String?      @unique  // URL-friendly identifier
  imageUrl    String?      // Shop logo/banner
  type        ShopType     @default(General)
  
  shopDiscounts     Json?
  shopCodeDiscounts Json?

  isPublished Boolean      @default(false)
  isFeatured  Boolean      @default(false)
  sortOrder   Int?         // For manual ordering
  
  ownerId     String
  eventId     String?
  
  // Contact/Business info
  contactEmail String?
  contactPhone String?
  termsAndConditions String?

  shopItems   ShopItem[]   @relation("ShopToShopItem")
  payments    Payment[]
  event       Event?       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
}

model ShopItem {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  disabled    Boolean      @default(false)

  title       String
  description String?      @db.Text  // Detailed description
  sku         String?      @unique   // Stock keeping unit
  type        ShopItemType
  imageUrl    String?      // Background for the item
  images      String[]     // Multiple images
  
  // Inventory
  limit       Int?
  stockCount  Int?         // Current stock level
  lowStockThreshold Int?   // Alert threshold
  trackInventory Boolean   @default(false)
  
  // Pricing
  price       Decimal
  currency    String       @default("CAD")
  discountMemberPercent    Int?
  taxPercent  Int?         // If empty, there is no tax
  
  // Purchase constraints
  minQuantity Int?         @default(1)
  maxQuantity Int?
  
  // Availability
  status      ItemStatus   @default(AVAILABLE)
  validFrom   DateTime?
  validTo     DateTime?
  
  // Display
  isFeatured  Boolean      @default(false)
  sortOrder   Int?
  
  // Stripe catalog mapping
  stripeProductId         String
  stripePriceId           String
  subscribedStripePriceId String?
  
  // Physical item properties (optional)
  weight           Decimal?
  weightUnit       String?  @default("kg")
  dimension        String?
  
  // Relations
  shops       Shop[]        @relation("ShopToShopItem")
  tags        ShopItemTag[] @relation("ShopItemTagToShopItem")
  payments    Payment[]
}

model ShopItemTag {
  id        String       @id @default(cuid())
  title     String
  shopItem  ShopItem[]      @relation("ShopItemTagToShopItem")
}

model Receipt {
  id                String               @id @default(cuid())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  // Basic receipt metadata
  receiptNumber     String?
  receiptDate       DateTime             @default(now())
  merchantName      String
  merchantAddress   String?

  // Financial totals
  currency          String               @default("CAD")
  subtotal          Decimal              @default(0)
  taxAmount         Decimal              @default(0)
  tipAmount         Decimal              @default(0)
  discountAmount    Decimal              @default(0)
  totalAmount       Decimal

  // Spending classification
  note              String?
  paymentMethod     ExpensePaymentMethod @default(Other)
  paymentReference  String? // e.g. card last4, transaction id, cheque number
  hasReimbursed     Boolean              @default(false)

  // Optional file/ocr payload
  receiptImageUrl   String?
  rawText           String?              @db.Text

  // Relations
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          ExpenseCategoryType  @default(Other)
  items             ReceiptItem[]

  @@index([userId, receiptDate])
}

model ReceiptItem {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  description String
  quantity    Decimal  @default(1)
  unitPrice   Decimal
  taxAmount   Decimal? @default(0)
  discount    Decimal? @default(0)
  lineTotal   Decimal

  receiptId   String
  receipt     Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

enum Role {
  SUPERADMIN
  USER
  ADMIN
  HOST
  WRITER
  SHOPOWNER
}

enum EventType {
  CLASS
  CONCERT
  CAMPING
  EVENT
}

enum JobType {
  Performance
  Marketing
  ProjectManager
  HR
  Tech
  Finance
  Volunteer
}

enum CategoryType {
  Primary
  Secondary
}

enum PaymentType {
  Membership
  ClassFullCourse
  ClassDropIn
  Concert
  Camping
  Event
  Class
  Shop
  Refund
}

enum PaymentMethod {
  ETF
  BankTransfer
  Cash
  Stripe
  None
}

enum ReviewRating {
  One   @map("1")
  Two   @map("2")
  Three @map("3")
  Four  @map("4")
  Five  @map("5")
}

enum SponsorTier {
  Platinum
  Gold
  Silver
  Bronze
}

enum CheckoutSessionStatus {
  PENDING      // Session created, awaiting payment
  COMPLETED    // Payment successful, webhook processed
  EXPIRED      // Session expired (Stripe session expired)
  CANCELLED    // User cancelled the checkout
}

enum ShopItemType {
  General
  Limit
  Discount
}

enum ItemStatus {
  AVAILABLE
  OUT_OF_STOCK
  DISCONTINUED
  COMING_SOON
}

enum ShopType {
  General
  Food
  Clothes
  Event
  Fundraiser
  Digital
  Seasonal
}

enum ExpensePaymentMethod {
  Cash
  Card
  BankTransfer
  EWallet
  Cheque
  Other
}

enum ExpenseCategoryType {
  Food
  Transportation
  Shopping
  Utilities
  Housing
  Health
  Education
  Entertainment
  Travel
  Insurance
  Salary
  Tax
  Office
  Subscription
  Gift
  Other
}